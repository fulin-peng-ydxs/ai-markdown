{
  "name": "plainroot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": "11.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:inventory": "node scripts/check-licenses.mjs --json",
    "test:licenses": "node --test scripts/check-licenses.test.mjs",
    "test:permanent-delete-feedback": "node --test --experimental-strip-types scripts/permanent-delete-feedback.test.mjs",
    "test:workspace-tree": "node --test --experimental-strip-types scripts/workspace-tree-state.test.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "6.0.2",
    "vite": "8.1.4"
  }
}
