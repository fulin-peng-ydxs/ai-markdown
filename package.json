{
  "name": "plainroot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.11.1 <25",
    "pnpm": "11.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:inventory": "node scripts/check-licenses.mjs --json",
    "test:licenses": "node --test scripts/check-licenses.test.mjs",
    "test:permanent-delete-feedback": "node --test --experimental-strip-types scripts/permanent-delete-feedback.test.mjs",
    "test:editor-poc": "vitest run src/features/editor/poc/editorPoc.test.ts",
    "test:editor-poc:performance": "node scripts/editor-poc-report.mjs",
    "test:editor": "vitest run src/features/editor",
    "test:roundtrip": "vitest run src/features/editor/roundtripCorpus.test.ts",
    "test:document-session": "vitest run src/features/editor/documentHistory.test.ts src/features/editor/markdownCompatibility.test.ts src/features/editor/documentSession.test.ts",
    "test:document-session:performance": "node --experimental-strip-types scripts/document-history-report.mjs",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --lib --no-default-features",
    "test:workspace-path": "node --test --experimental-strip-types scripts/workspace-path.test.mjs",
    "test:ui": "vitest run",
    "test:workspace-tree": "node --test --experimental-strip-types scripts/workspace-tree-state.test.mjs",
    "test:fixtures": "node --test tests/support/workspace-fixture.test.mjs",
    "test": "pnpm test:licenses && pnpm test:permanent-delete-feedback && pnpm test:workspace-path && pnpm test:workspace-tree && pnpm test:fixtures && pnpm test:ui && pnpm test:rust",
    "typecheck": "tsc -b --pretty false",
    "test:e2e:build": "tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "test:e2e": "pnpm test:e2e:build && node scripts/run-desktop-e2e.mjs",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.1",
    "@codemirror/language": "6.12.4",
    "@codemirror/search": "6.7.1",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.6",
    "@milkdown/kit": "7.21.3",
    "@milkdown/react": "7.21.3",
    "@tauri-apps/api": "2.11.1",
    "codemirror": "6.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark": "15.0.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@wdio/cli": "9.29.1",
    "@wdio/local-runner": "9.29.1",
    "@wdio/mocha-framework": "9.29.1",
    "@wdio/spec-reporter": "9.29.1",
    "@wdio/tauri-plugin": "1.2.0",
    "@wdio/tauri-service": "1.2.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
